function renderVpsTab(s: Snapshot): string {
  const h = s.hostinger;
  return `
<section class="vps-section">
  ${renderVpsIdentityFull(s)}
  ${renderFirewallCard()}
  ${renderSshKeysCard()}
  ${h.configured ? renderHostingerDetail(s) : renderHostingerEmpty()}
  ${renderInfraDetail(s)}
</section>`;
}

function renderAgentRoster(): string {
  return `
<section class="roster-section">
  <header class="section-row">
    <h2 class="section-h">Agent roster</h2>
    <span class="section-meta" data-roster-meta>Loading…</span>
  </header>
  <div class="roster-grid" data-agent-roster>
    <article class="roster-tile roster-loading"><span class="roster-name">Loading…</span></article>
  </div>
</section>`;
}

function renderFailedCronsPanel(): string {
  return `
<section class="failed-crons-section" data-failed-crons-section hidden>
  <header class="section-row">
    <h2 class="section-h">Failed crons</h2>
    <span class="section-meta" data-failed-crons-meta></span>
  </header>
  <ul class="failed-crons-list" data-failed-crons-list></ul>
</section>`;
}

function renderFirewallCard(): string {
  return `
<article class="card firewall-card" data-firewall-card>
  <h3 class="card-h">Firewall <span class="count" data-firewall-rule-count>—</span></h3>
  <div class="firewall-meta" data-firewall-meta>Loading…</div>
  <button class="link-btn" type="button" data-firewall-view hidden>View rules ${icon("chevron-right", 14)}</button>
</article>`;
}

function renderSshKeysCard(): string {
  return `
<article class="card ssh-keys-card" data-ssh-keys-card>
  <h3 class="card-h">SSH keys <span class="count" data-ssh-count>—</span></h3>
  <ul class="ssh-keys-list" data-ssh-keys-list>
    <li class="ssh-loading">Loading…</li>
  </ul>
</article>`;
}

function renderVpsIdentityFull(s: Snapshot): string {
  const vm = s.hostinger.vm;
  const dc = s.hostinger.dataCenter;
  if (!vm) return renderIdentityCard(s);
  const ipv4 = vm.ipv4[0]?.address ?? "—";
  const ipv6 = vm.ipv6[0]?.address ?? "—";
  return `
<article class="card vps-full">
  <header class="section-row">
    <h2 class="section-h">Server</h2>
    <span class="section-meta">From Hostinger</span>
  </header>
  <h3 class="vps-host">${escape(vm.hostname)}</h3>
  <div class="vps-meta">
    <span class="mono">${escape(ipv4)}</span>
    <span class="sep">·</span>
    <span class="mono dim">${escape(ipv6)}</span>
  </div>
  <dl class="kv-grid">
    <div><dt>Status</dt><dd><span class="dot dot-${vm.state === "running" ? "ok" : "warn"}"></span> ${escape(vm.state === "running" ? "Running" : vm.state)}</dd></div>
    <div><dt>Plan</dt><dd>${escape(vm.plan)}</dd></div>
    <div><dt>Operating system</dt><dd>${escape(vm.template.name)}</dd></div>
    <div><dt>Region</dt><dd>${dc ? escape(dc.city + ", " + dc.location.toUpperCase()) : "—"}</dd></div>
    <div><dt>vCPU</dt><dd>${vm.cpus}</dd></div>
    <div><dt>Memory</dt><dd>${Math.round(vm.memoryMb / 1024)} GB</dd></div>
    <div><dt>Storage</dt><dd>${Math.round(vm.diskMb / 1024)} GB</dd></div>
    <div><dt>Bandwidth</dt><dd>${Math.round(vm.bandwidthMb / 1024)} GB / mo</dd></div>
    <div><dt>Provisioned</dt><dd title="${escape(stamp(vm.createdAt))}">${escape(friendlyDate(vm.createdAt))}</dd></div>
    <div><dt>Lock state</dt><dd>${vm.actionsLock === "unlocked" ? "Unlocked" : `<span class="pill pill-warn">${escape(vm.actionsLock)}</span>`}</dd></div>
  </dl>
</article>`;
}

function renderHostingerEmpty(): string {
  return `
<article class="card empty-card">
  <h3>Hostinger token not configured</h3>
  <p>Set <code>HOSTINGER_API_TOKEN</code> in Doppler <code>agent-platform/prd_hostinger</code> to see backups, subscriptions, and domains here.</p>
</article>`;
}

function renderHostingerDetail(s: Snapshot): string {
  const backups = s.hostinger.backups;
  const subs = s.hostinger.subscriptions;
  const domains = s.hostinger.domains;
  return `
<article class="card list-card">
  <h3 class="card-h">Backups <span class="count">${backups.length}</span></h3>
  ${
    backups.length === 0
      ? renderEmpty("No backups yet", "Hostinger hasn't stored any backups for this server.")
      : `<ul class="stack-list">
          ${backups
            .map(
              (b) => `
            <li>
              <div class="stack-primary" title="${escape(stamp(b.created_at))}">${escape(friendlyDate(b.created_at))}</div>
              <div class="stack-meta">${bytes(b.size * 1024)} · stored in ${escape(b.location)} · ${friendlyDuration(b.restore_time)} to restore</div>
            </li>`,
            )
            .join("")}
        </ul>`
  }
</article>

<article class="card list-card">
  <h3 class="card-h">Subscriptions <span class="count">${subs.length}</span></h3>
  ${
    subs.length === 0
      ? renderEmpty("No subscriptions", "Nothing to bill.")
      : `<ul class="stack-list">
          ${subs
            .map(
              (sub) => `
            <li>
              <div class="stack-primary">${escape(sub.name)}</div>
              <div class="stack-meta">$${(sub.total_price / 100).toFixed(0)} ${escape(sub.currency_code)}/yr · ${sub.is_auto_renewed ? "auto-renews" : "renews manually"} <span title="${escape(stamp(sub.next_billing_at))}">${escape(friendlyDate(sub.next_billing_at))}</span></div>
              <div class="stack-status badge-${sub.status === "active" ? "ok" : "warn"}">${escape(sub.status === "active" ? "Active" : sub.status)}</div>
            </li>`,
            )
            .join("")}
        </ul>`
  }
</article>

<article class="card list-card">
  <h3 class="card-h">Domains <span class="count">${domains.length}</span></h3>
  ${
    domains.length === 0
      ? renderEmpty("No domains", "Add a domain in Hostinger to see it here.")
      : `<ul class="stack-list">
          ${domains
            .map(
              (d) => `
            <li>
              <div class="stack-primary">${escape(d.domain ?? `Pending setup`)}</div>
              <div class="stack-meta">Created <span title="${escape(stamp(d.created_at))}">${escape(friendlyDate(d.created_at))}</span>${d.expires_at ? ` · expires <span title="${escape(stamp(d.expires_at))}">${escape(friendlyDate(d.expires_at))}</span>` : ""}</div>
              <div class="stack-status badge-${d.status === "active" ? "ok" : "warn"}">${escape(d.status.replace(/_/g, " "))}</div>
            </li>`,
            )
            .join("")}
        </ul>`
  }
</article>`;
}

function renderInfraDetail(s: Snapshot): string {
  return `
<article class="card list-card">
  <h3 class="card-h">System services <span class="count">${s.services.length}</span></h3>
  <ul class="stack-list">
    ${s.services
      .map(
        (sv) => `
      <li>
        <div class="stack-primary mono">${escape(sv.unit)}</div>
        <div class="stack-status badge-${sv.active === "active" ? "ok" : sv.active === "failed" ? "bad" : "warn"}">
          <span class="dot dot-${sv.active === "active" ? "ok" : sv.active === "failed" ? "bad" : "warn"}"></span>
          ${escape(sv.active === "active" ? "Running" : sv.active === "inactive" ? "Stopped" : sv.active === "failed" ? "Failed" : "Unknown")}
        </div>
      </li>`,
      )
      .join("")}
  </ul>
</article>

<article class="card list-card">
  <h3 class="card-h">Containers <span class="count">${s.docker.length}</span></h3>
  ${
    s.docker.length === 0
      ? renderEmpty("No containers", "Nothing running in Docker right now.")
      : `<ul class="stack-list">
          ${s.docker
            .map(
              (c) => `
            <li>
              <div class="stack-primary mono">${escape(c.name)}</div>
              <div class="stack-meta mono">${escape(c.image)}</div>
              <div class="stack-status">${escape(c.status)}</div>
            </li>`,
            )
            .join("")}
        </ul>`
  }
</article>`;
}

// ────────────────────────────────────────────────────────
// TASKS
// ────────────────────────────────────────────────────────

function renderTasks(s: Snapshot): string {
  const active = s.tasks.active;
  const recent = s.tasks.recent.filter((t) => t.status !== "active").slice(0, 10);
  return `
<section class="tasks-tab">
  <header class="section-row">
    <h2 class="section-h">Tasks</h2>
    <span class="section-meta">${active.length} active · ${s.tasks.companies.length} ${s.tasks.companies.length === 1 ? "company" : "companies"}</span>
  </header>

  <h3 class="sub-h">Active now</h3>
  ${active.length === 0 ? renderEmpty("Nothing active", "The pool is idle, ready for the next job.") : active.map((t) => renderTaskRow(t)).join("")}

  <h3 class="sub-h">Recent</h3>
  ${recent.length === 0 ? renderEmpty("No recent runs", "Past tasks will show up here once you've kicked some off.") : recent.map((t) => renderTaskRow(t)).join("")}

  <h3 class="sub-h">Companies</h3>
  <article class="card list-card">
    <ul class="stack-list">
      ${s.tasks.companies
        .map(
          (co) => `
        <li>
          <div class="stack-primary">${escape(co.slug)}</div>
          <div class="stack-meta">${co.projects.length ? co.projects.length + " " + (co.projects.length === 1 ? "project" : "projects") + ": " + escape(co.projects.join(", ")) : "No projects yet"}</div>
          <div class="stack-status">${co.paperclipMapped ? `<span class="pill pill-ok">Paperclip linked</span>` : ""}</div>
        </li>`,
        )
        .join("")}
    </ul>
  </article>
</section>`;
}

function renderTaskRow(t: import("../lib/tasks.ts").CompanyTask): string {
  const risk = (t.riskLevel ?? "low").toLowerCase();
  const riskLabel = risk === "high" ? "High risk" : risk === "med" || risk === "medium" ? "Medium risk" : "Low risk";
  const modeLabel = friendlyMode(t.mode);
  return `
  <article class="card task-card risk-${escape(risk)}">
    <header class="task-head">
      <span class="task-co mono">${escape(t.company)} / ${escape(t.project)}</span>
      <span class="task-age" title="${escape(stamp(t.createdUtc))}">${escape(ago(t.createdUtc))}</span>
    </header>
    <h4 class="task-name">${escape(titleCase(t.taskName))}</h4>
    <div class="task-meta">
      <span class="task-risk-pill risk-${escape(risk)}">${escape(riskLabel)}</span>
      ${modeLabel ? `<span class="task-chip">${escape(modeLabel)}</span>` : ""}
      ${t.workerProfile ? `<span class="task-chip">${escape(titleCase(t.workerProfile))}</span>` : ""}
      ${t.githubRepo ? `<span class="task-repo mono dim">${escape(t.githubRepo)}</span>` : ""}
    </div>
  </article>`;
}

function friendlyMode(mode?: string): string {
  if (!mode) return "";
  switch (mode) {
    case "read_or_analysis": return "Review only";
    case "implementation_to_pr": return "Implementation → PR";
    case "readonly": return "Read only";
    default: return mode.replace(/_/g, " ").replace(/^./, (c) => c.toUpperCase());
  }
}

