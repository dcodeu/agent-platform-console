[Unit]
Description=Agent Platform Console (live dashboard for Hermes / Paperclip / VPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/agent-platform/apps/console
Environment=NODE_ENV=production
Environment=CONSOLE_HOST=127.0.0.1
Environment=CONSOLE_PORT=8080
ExecStart=/usr/bin/node --experimental-strip-types src/server.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
StandardOutput=append:/opt/agent-platform/logs/console.log
StandardError=append:/opt/agent-platform/logs/console.err
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/agent-platform/logs

[Install]
WantedBy=default.target
